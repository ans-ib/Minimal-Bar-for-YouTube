{
  "name": "minimal-bar-for-youtube",
  "version": "1.0.0",
  "description": "Minimal progress bar with chapter and time labels while YouTube's controls are hidden, plus mouse-wheel volume over the video.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Anas Ibn Bari",
  "homepage": "https://github.com/ans-ib/Minimal-Bar-for-YouTube#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ans-ib/Minimal-Bar-for-YouTube.git"
  },
  "bugs": {
    "url": "https://github.com/ans-ib/Minimal-Bar-for-YouTube/issues"
  },
  "funding": "https://ko-fi.com/ansib",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/build.js --clean",
    "build": "npm run build:chromium",
    "build:chromium": "node scripts/build.js --target=chromium",
    "build:firefox": "node scripts/build.js --target=firefox",
    "watch": "node scripts/build.js --target=chromium --watch",
    "watch:firefox": "node scripts/build.js --target=firefox --watch",
    "package": "npm run package:chromium && npm run package:firefox",
    "source:mozilla": "node scripts/build.js --source",
    "submit": "node scripts/submit.js",
    "submit:dry": "node scripts/submit.js --dry-run",
    "submit:plan": "node scripts/submit.js --plan",
    "submit:init": "publish-extension init",
    "package:chromium": "node scripts/build.js --target=chromium --package",
    "package:firefox": "node scripts/build.js --target=firefox --package",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir dist",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "publish-browser-extension": "^6.1.1",
    "tailwindcss": "^3.4.19",
    "web-ext": "^10.6.0"
  }
}
