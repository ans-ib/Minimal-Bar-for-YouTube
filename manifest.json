{
  "manifest_version": 3,
  "name": "YouTube Enhancer",
  "version": "1.0.0",
  "description": "Enhances YouTube with always-visible native controls and scroll-to-volume",
  "permissions": [],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "content/youtubeDetector.js",
        "content/progressBar.js",
        "content/scrollVolume.js",
        "content/content.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
